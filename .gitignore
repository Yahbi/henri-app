# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.*/
/out/

# Tailwind v4 + Turbopack 16.2.3 scans the whole project root for
# class strings. Worktree archives or stale build dirs left at the
# root can re-introduce arbitrary-value classes that trip a parser bug
# on `shadow-[hsl(var(--…)/X)]` patterns. Keep them out of scan range.
# (See docs/audits/2026-04-27 / preview-launch session notes.)
/.claude/worktrees/
/.claude/worktrees.*/
/scripts/.import-state.json
/scripts/.import-log.txt

# production
/build

# misc
.DS_Store
*.pem
# Local fallback inbox used by /api/feedback when RESEND_API_KEY and
# the `feedback` DB table are both unavailable. Must not be committed —
# it contains user emails, IDs, and browser fingerprints.
.henri-feedback.jsonl

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Launch automation scripts (reference deploy tokens at runtime; never
# commit values into source). Diagnostic scripts in scripts/ are fine
# to commit; only the deploy-flow ones are ignored.
/scripts/_deploy-vercel.ts
/scripts/_setup-cloudflare-dns.ts
/scripts/_supabase-management.ts

# typescript
*.tsbuildinfo
next-env.d.ts
