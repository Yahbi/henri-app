# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next.*/
/out/

# Tailwind v4 + Turbopack 16.2.3 scans the whole project root for
# class strings. Worktree archives or stale build dirs left at the
# root can re-introduce arbitrary-value classes that trip a parser bug
# on `shadow-[hsl(var(--…)/X)]` patterns. Keep them out of scan range.
# (See docs/audits/2026-04-27 / preview-launch session notes.)
/.claude/worktrees/
/.claude/worktrees.*/
/scripts/.import-state.json
/scripts/.import-log.txt

# production
/build

# misc
.DS_Store
*.pem
# Local fallback inbox used by /api/feedback when RESEND_API_KEY and
# the `feedback` DB table are both unavailable. Must not be committed —
# it contains user emails, IDs, and browser fingerprints.
.henri-feedback.jsonl
# Newsletter signup fallback inbox (same threat model as feedback).
.henri-newsletter.jsonl

# Operational state for resumable backfill scripts. The scripts encode
# offset/cursor here so a crash doesn't force a re-scan from zero.
# Don't commit — values change on every run and leak nothing useful.
/scripts/.backfill-contact.state.json
/scripts/.import-state.json
# Operational logs from one-shot ops scripts (drain, enrich loop).
/scripts/_score_drain.log
# Recurring health-probe JSONL log (timestamped Supabase endpoint
# checks). Contains environment URLs + cron summaries — operational
# data, not secret, but shouldn't be in source control.
/scripts/_health_probe.log

# Login screenshots and other ad-hoc images saved at the repo root.
# Could expose credentials or session state captured during a
# screen-grab. Always reject, force the user to opt-in if a specific
# image needs to be tracked.
/*.png
/*.jpg
/*.jpeg
/*.heic

# Generated migration bundle — `pnpm migrate-bundle` writes the
# concatenated SQL to this path so it can be pasted into the
# Supabase SQL editor when the CLI auth is unavailable. Regeneratable
# from `supabase/migrations/`; not source.
/supabase/_pending-bundle.sql

# Local Claude Code plugin development tree. Distributed via a
# separate marketplace repo, not via the Henri app source.
/my-plugin/

# Internal preview routes that exist only on feature branches and
# should never reach main. The page comment says "Delete before
# merging to main" — pattern-match the directory name.
/src/app/preview/

# Claude Code session state (auto-generated lock + watch state).
/.claude/scheduled_tasks.lock
/.claude/data-watch-state.json
/.claude/settings.local.json.bak*

# Playwright artifacts (snapshots, console logs, traces).
/.playwright-mcp/
/test-results/

# Hex code-graph mirror dir.
/.hex-skills/

# Ad-hoc preview / screenshot output (don't commit).
/preview-*.html
/test-*.jpeg
/test-*.png
/henri-*.jpeg
/dashboard-*.jpeg
/dashboard-*.png
/drawer-*.jpeg
/drawer-*.png
/dev-mode-*.jpeg
/final-*.jpeg
/live-*.jpeg

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Launch automation scripts (reference deploy tokens at runtime; never
# commit values into source). Diagnostic scripts in scripts/ are fine
# to commit; only the deploy-flow ones are ignored.
/scripts/_deploy-vercel.ts
/scripts/_setup-cloudflare-dns.ts
/scripts/_supabase-management.ts

# typescript
*.tsbuildinfo
next-env.d.ts
